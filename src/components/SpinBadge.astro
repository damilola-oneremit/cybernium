---
/**
 * Circular "SPECIFY . SOURCE . DEPLOY" badge (Figma nodes 1:1085 / 1:1208 / 1:1383).
 * The letter ring is the exported Figma artwork (node 1:1088) rotating over a
 * static center arrow. Pass positioning classes (absolute/relative + offsets)
 * via `class`.
 */
interface Props {
  variant?: 'deep' | 'brand';
  bordered?: boolean;
  class?: string;
}

const { variant = 'brand', bordered = false, class: className = '' } = Astro.props;
const bg = variant === 'deep' ? 'bg-deep' : 'bg-brand';
---

<div class={`size-[138px] shrink-0 ${className}`} aria-hidden="true">
  <div class={`relative size-full overflow-clip rounded-full ${bg}`}>
    <img
      src="/assets/solar-arrow-left-down-linear-ffcf2873.svg"
      alt=""
      class="absolute top-1/2 left-1/2 size-[62px] -translate-x-1/2 -translate-y-1/2"
    />
    <!-- Letter ring from Figma (122.85px box at 7.8px inset), rotating -->
    <img
      src="/assets/spin-ring-1d5af26d.png"
      alt=""
      class="animate-spin-slow absolute top-[7.8px] left-[7.8px] size-[122.85px]"
    />
    {bordered && <div class="absolute inset-0 rounded-full border-[12px] border-white"></div>}
  </div>
</div>
